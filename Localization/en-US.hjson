Mods: {
	yasumi: {
		Items: {
			AttackUP: {
				DisplayName: Attack UP
				Tooltip: Right Click on weapon to add +20% damage.
			}

			AttackUPSummon: {
				DisplayName: Attack UP (Summon)
				Tooltip: Right Click on summon weapon to add +20% summon damage.
			}

			DefenseUP: {
				DisplayName: Defense UP
				Tooltip: Right Click on armor/accessories to add +1 Defense.
			}

			Resetter: {
				DisplayName: Resetter
				Tooltip: Right Click on upgraded item to reset to its default stats.
			}
		}

		Damagetext:
			'''
			[c/71B471:+{0}% damage] ([i:yasumi/AttackUP] x {1})
			[c/71B471: Original item damage is {2}.]
			'''
		Damagetextsummon:
			'''
			[c/71B471:+{0}% damage when held] ([i:yasumi/AttackUPSummon] x {1})
			[c/71B471:(Applied to all your summon-damage projectiles as well).]
			[c/71B471: Original item damage is {2}.]
			'''
		Defensetext:
			'''
			[c/71B471:+{0} defense (when worn).] ([i:yasumi/DefenseUP] x {1})
			[c/71B471:Original item defense is {2}.]
			'''
	}
}
