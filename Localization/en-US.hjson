Mods: {
	yasumi: {
		Items: {
			AttackUP: {
				DisplayName: Attack UP
				Tooltip: Right Click on weapon to add +20% Damage.
			}

			AttackUPSummon: {
				DisplayName: Attack UP (Summon)
				Tooltip: Right Click on summon weapon to add +2 Damage.
			}

			DefenseUP: {
				DisplayName: Defense UP
				Tooltip: Right Click on armor/accessories to add +1 Defense.
			}

			Resetter: {
				DisplayName: Resetter
				Tooltip: Right Click on upgraded item to reset to its default stats.
			}
		}

		Damagetext:
			'''
			[c/71B471:+{0}% damage] [i:yasumi/AttackUP]
			[c/71B471: Original item damage is {1}.]
			'''
		Damagetextsummon:
			'''
			[c/71B471:+{0}% damage (when held, applied to all your summoned projectiles as well).] [i:yasumi/AttackUPSummon]
			[c/71B471: Original item damage is {1}.]
			'''
		Defensetext:
			'''
			[c/71B471:+{0} defense (when worn).] [i:yasumi/DefenseUP]
			[c/71B471:Original item defense is {1}.]
			'''
	}
}
